{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "820px",
			"wideSize": "1320px"
		},
		"color": {
			"palette": [
				{
					"name": "Paper",
					"slug": "base",
					"color": "#F4F0EA"
				},
				{
					"name": "Ink",
					"slug": "contrast",
					"color": "#1B1916"
				},
				{
					"name": "Terracotta",
					"slug": "accent-1",
					"color": "#A8482A"
				},
				{
					"name": "Amber",
					"slug": "accent-2",
					"color": "#C98B2E"
				},
				{
					"name": "Walnut",
					"slug": "accent-3",
					"color": "#4A3728"
				},
				{
					"name": "Steel",
					"slug": "accent-4",
					"color": "#5C6063"
				},
				{
					"name": "Kraft",
					"slug": "accent-5",
					"color": "#E9DFCE"
				},
				{
					"name": "Accent 6",
					"slug": "accent-6",
					"color": "color-mix(in srgb, currentColor 20%, transparent)"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, sans-serif",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2" ],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Manrope"
						}
					]
				},
				{
					"name": "Literata",
					"slug": "literata",
					"fontFamily": "Literata, serif",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/literata/Literata72pt-Light.woff2" ],
							"fontWeight": "300",
							"fontStyle": "normal",
							"fontFamily": "Literata"
						},
						{
							"src": [ "file:./assets/fonts/literata/Literata72pt-Regular.woff2" ],
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontFamily": "Literata"
						},
						{
							"src": [ "file:./assets/fonts/literata/Literata72pt-SemiBold.woff2" ],
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontFamily": "Literata"
						}
					]
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--literata)",
					"fontWeight": "400",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(2.4rem, 4.5vw, 3.5rem)",
					"fontWeight": "300"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(1.8rem, 3vw, 2.4rem)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-3)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-1)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent-1)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "2px"
				},
				"spacing": {
					"padding": {
						"top": "0.9em",
						"bottom": "0.9em",
						"left": "1.6em",
						"right": "1.6em"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-3)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--literata)",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--literata)",
					"fontWeight": "400"
				}
			}
		}
	}
}
