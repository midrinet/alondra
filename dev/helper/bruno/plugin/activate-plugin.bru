meta {
  name: Activate Plugin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/?alondra-webhook=activate_plugin
  body: none
  auth: none
}

params:query {
  ~plugin: alondra/alondra.php
}

docs {
  Activates a plugin programmatically (page-free, no wp-admin confirm/redirect), via
  activate_plugin(). No-op if already active.

  Params (query, optional): plugin - plugin basename to activate. Defaults to
  `alondra/alondra.php` (the live Alondra plugin) when omitted; override to activate the
  disposable copy Provision Plugin Copy creates (`alondra-uninstall-copy/alondra.php`).
}
