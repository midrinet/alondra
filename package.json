{
  "name": "alondra",
  "description": "Advanced tiered pricing for WooCommerce.",
  "scripts": {
    "rmcss": "rm -f ./assets/css/*.watch && rm -f ./assets/css/*.map && rm -f ./assets/css/*.css",
    "cpfonts": "mkdir -p ./assets/font",
    "autoprefix": "postcss assets/css/admin.css --use=autoprefixer --output=assets/css/admin.css && postcss assets/css/admin.css --use=autoprefixer --output=assets/css/admin.css",
    "build": "pnpm run cpfonts && pnpm run rmcss && webpack --mode production --progress && sass --style=compressed --no-source-map ./assets/css/scss:./assets/css/ && pnpm run autoprefix",
    "dev": "pnpm run cpfonts && pnpm run rmcss && webpack --mode development --progress && sass ./assets/css/scss:./assets/css/"
  },
  "author": "MidriNet",
  "license": "GPL-2.0-or-later",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "browserslist": [
    "last 2 versions",
    "ie >= 8",
    "edge >= 15",
    "ie_mob >= 10",
    "ff >= 45",
    "chrome >= 45",
    "safari >= 5",
    "opera >= 23",
    "ios >= 7",
    "android >= 4",
    "bb >= 10"
  ],
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "cssnano": "^9.2.2",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-loader": "^8.2.1",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "tom-select": "^2.6.2"
  }
}
