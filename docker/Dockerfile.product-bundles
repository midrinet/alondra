# Carries the WooCommerce Product Bundles zip, a paid extension kept out of the repository,
# for CI to extract with `docker create` + `docker cp`. Built and pushed by
# scripts/publish-product-bundles; never run.
FROM scratch
# No source label on purpose: the package stays private and unlinked from this public repository.
# Each repository that pulls it with GITHUB_TOKEN is granted read access in the package's settings.
ARG PB_ZIP
COPY plugins/${PB_ZIP} /
