{
    "name": "midrinet/alondra",
    "type": "project",
    "description": "Advanced tiered pricing for WooCommerce.",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Midrinet",
            "email": "support@midri.net"
        }
    ],
    "config": {
        "platform": {
            "php": "7.4.0"
        },
        "sort-packages": true,
        "classmap-authoritative": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "szepeviktor/phpstan-wordpress": true
        }
    },
    "autoload": {
        "psr-4": {
            "Midrinet\\Alondra\\": "src/"
        }
    },
    "require": {
        "freemius/wordpress-sdk": "^2.0.0"
    },
    "require-dev": {
        "automattic/vipwpcs": "^3.0",
        "php-stubs/woocommerce-stubs": "^10.6.2",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1.46",
        "phpunit/phpunit": ">5.0",
        "sirbrillig/phpcs-variable-analysis": "^2.11",
        "szepeviktor/phpstan-wordpress": "^2.0.3",
        "woocommerce/woocommerce-sniffs": "^1.0",
        "yoast/phpunit-polyfills": "^1.0"
    },
    "prefer-stable": true
}
