# The version of MariaDB to use. See available tags at https://hub.docker.com/_/mariadb/tags
MARIADB_TAG=latest
# PHP version to use
PHP_VERSION=8.3
# The version of WordPress to use.
WP_VERSION=7.1
# The WooCommerce version to use
WC_VERSION=11.0.1
# The name of the database to create
MARIADB_DATABASE=exampledb
# The name of the database user to create
MARIADB_USER=exampleuser
# The password for the database user
MARIADB_PASSWORD=examplepass
# The password for the root user
MARIADB_ROOT_PASSWORD=root
# The hostname of the database server
WORDPRESS_DB_HOST=db
# For the wp-config.php file. Same as MARIADB_USER
WORDPRESS_DB_USER=$MARIADB_USER
# For the wp-config.php file. Same as MARIADB_PASSWORD
WORDPRESS_DB_PASSWORD=$MARIADB_PASSWORD
# For the wp-config.php file. Same as MARIADB_DATABASE
WORDPRESS_DB_NAME=$MARIADB_DATABASE
# Enable WordPress debug mode
WORDPRESS_DEBUG=1
# The WordPress wp-admin username
WP_ADMIN_USER=admin
# The WordPress wp-admin password
WP_ADMIN_PASSWORD=admin 
# The WordPress wp-admin email
WP_ADMIN_EMAIL=admin@alondra.local
# The port to expose the WordPress service
WP_HTTP_PORT=8080
# The WordPress site URL
WP_URL=http://localhost:$WP_HTTP_PORT
# The WordPress site locale
WP_LOCALE="en_US"
# The WordPress theme to install from WP repository.
# You can add the version of the theme to install.
# Example: WP_PLUGINS="twentytwentyfour:1.0.0"
WP_THEME="twentytwentyfour"
# The WordPress plugins to install from WP repository. You can add more plugins separated by commas.
# Example: WP_PLUGINS="woocommerce,contact-form-7"
# Also, you can add the version of the plugin to install.
# Example: WP_PLUGINS="woocommerce:6.0.0"
WP_PLUGINS="woocommerce:$WC_VERSION"
WORDPRESS_CONFIG_EXTRA="define( 'WP_LOCALE', getenv_docker('WP_LOCALE', 'en_US') );define( 'WP_DEBUG_DISPLAY', false );define( 'WP_DEBUG_LOG', true );define( 'WP_AUTO_UPDATE_CORE', false );define('WP_CACHE', true);"

# Directory holding the WooCommerce Product Bundles zip scripts/setup installs. The zip is not
# tracked in git. Start it with ./ or /, or compose reads it as a named volume.
# PB_ZIP_PATH=./docker/plugins
# The Product Bundles release that zip carries, and the one place its version lives: scripts/setup
# and every CI workflow read it from here, and CI pulls the zip from the image
# scripts/publish-product-bundles pushed under this tag.
PB_VERSION=8.5.11

# For Publishing Docker Image
CONTAINER_REGISTRY=ghcr.io
CONTAINER_REGISTRY_USER=midrinet
CONTAINER_REGISTRY_TOKEN=